# ──────────────────────────────────────────────
# openDesk Compose — Configuration
# ──────────────────────────────────────────────
# Copy to .env and adjust for your deployment.
# See README.md for hardware recommendations per tier.

# ── Domains ──
OPENDESK_DOMAIN=opendesk-sme.org
OPENCLOUD_DOMAIN=cloud.opendesk-sme.org
MAIL_DOMAIN=mail.opendesk-sme.org
SOGO_DOMAIN=webmail.opendesk-sme.org
COLLABORA_DOMAIN=collabora.opendesk-sme.org
KEYCLOAK_DOMAIN=auth.opendesk-sme.org
PORTAL_DOMAIN=portal.opendesk-sme.org

# ── Database ──
POSTGRES_PASSWORD=CHANGEME_postgres
KEYCLOAK_DB_PASSWORD=CHANGEME_keycloak
SOGO_DB_PASSWORD=CHANGEME_sogo

# ── LDAP ──
LDAP_DOMAIN=opendesk-sme.org
LDAP_ORGANISATION=openDesk
LDAP_ADMIN_PASSWORD=CHANGEME_ldap
LDAP_READONLY_USER_PASSWORD=CHANGEME_ldap_ro
LDAP_USER_PASSWORD=CHANGEME_user

# ── Keycloak ──
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGEME_keycloak_admin

# ── OpenCloud ──
OC_ADMIN_USERNAME=admin
OC_ADMIN_PASSWORD=CHANGEME_oc_admin
OC_OIDC_SECRET=CHANGEME_oidc_secret
OC_S3_ENDPOINT=http://minio:9000
OC_S3_ACCESS_KEY=minio
OC_S3_SECRET_KEY=CHANGEME_minio

# ── Collabora ──
COLLABORA_USERNAME=admin
COLLABORA_PASSWORD=CHANGEME_collabora

# ── Email ──
POSTMASTER=postmaster@opendesk-sme.org
STALWART_ADMIN_PASSWORD=

# ── Traefik ──
TRAEFIK_ACME_ENABLED=false
TRAEFIK_ACME_EMAIL=admin@opendesk-sme.org
TRAEFIK_USERS=admin:$$2y$$10$$CHANGEME

# ── Logging ──
LOG_LEVEL=info
LOG_PRETTY=true

# ── Resource Profiles ──
# Set to "starter" | "business" | "enterprise" to apply resource limits
# See README.md → Hardware Recommendations
OPENDESK_TIER=starter

# ── Feature Flags (set COMPOSE_FILE in env or cli) ──
COMPOSE_FILE=docker-compose.yml
