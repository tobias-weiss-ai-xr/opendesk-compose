# =============================================================================
# openDesk Docker Compose — Environment Configuration
# =============================================================================
# Copy: cp .env.example .env.production && edit
#
# REQUIRED: DOMAIN, POSTGRES_PASSWORD, CASDOOR_ADMIN_PASSWORD
# =============================================================================

# ---------------------------------------------------------------------------
# Zendis Registry (for Zendis image pull)
# ---------------------------------------------------------------------------
# docker login registry.opencode.de -u "$OD_PRIVATE_REGISTRY_USERNAME"
OD_PRIVATE_REGISTRY_USERNAME=
OD_PRIVATE_REGISTRY_PASSWORD=

# ---------------------------------------------------------------------------
# Domain
# ---------------------------------------------------------------------------
DOMAIN=example.com
EMAIL_DOMAIN=mail.example.com
ACME_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Database (single PostgreSQL for all services)
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=changeme

# Per-service DB passwords
CASDOOR_DB_PASSWORD=changeme
SYNAPSE_DB_PASSWORD=changeme
OPENCLOUD_DB_PASSWORD=changeme
NOTES_DB_PASSWORD=changeme
SOGO_DB_PASSWORD=changeme
PAPERLESS_DB_PASSWORD=changeme
INVOICENINJA_DB_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Casdoor — OIDC/OAuth2 SSO (central authentication for all services)
# ---------------------------------------------------------------------------
# Web UI: https://auth.example.com
# Default admin: admin / <CASDOOR_ADMIN_PASSWORD>
CASDOOR_ADMIN_PASSWORD=changeme

# ---------------------------------------------------------------------------
# SOGo (Webmail + Calendar + Contacts)
# OAuth2 client registered in Casdoor for SOGo login.
# After setup, create an application "sogo" in Casdoor admin panel.
SOGO_ADMIN_USER=admin
SOGO_ADMIN_PASSWORD=changeme
SOGO_OAUTH2_CLIENT_SECRET=changeme

# ---------------------------------------------------------------------------
# OpenCloud (File Sharing, --profile office)
# ---------------------------------------------------------------------------
OPENCLOUD_ADMIN_USER=admin
OPENCLOUD_ADMIN_PASSWORD=changeme

# ---------------------------------------------------------------------------
# MinIO (S3 Object Storage, --profile notes only)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---------------------------------------------------------------------------
# Notes / Impress (--profile notes only)
# ---------------------------------------------------------------------------
NOTES_DJANGO_SECRET_KEY=changeme-generate-random-key
NOTES_OIDC_CLIENT_SECRET=changeme
NOTES_COLLABORATION_SECRET=changeme

# ---------------------------------------------------------------------------
# CryptPad (--profile collab only)
# ---------------------------------------------------------------------------
CPAD_SESSION_SECRET=changeme
CRYPTPAD_ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Paperless-ngx (Document Management)
# ---------------------------------------------------------------------------
PAPERLESS_SECRET_KEY=changeme-generate-64-char-random-string
PAPERLESS_DB_PASSWORD=changeme
TZ=Europe/Berlin

# ---------------------------------------------------------------------------
# Invoice Ninja (Invoicing)
# ---------------------------------------------------------------------------
INVOICENINJA_DB_PASSWORD=changeme
